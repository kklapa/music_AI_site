# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Обов'язково змініть на довгий випадковий рядок (мін. 48 символів)
JWT_SECRET=change_me_to_a_very_long_random_secret_string_please_1234567890

# true — якщо працюєте через HTTPS (Cloudflare Tunnel)
COOKIE_SECURE=true

# Домен, за яким доступний сайт (для PWA/OG)
PUBLIC_URL=https://music.example.com

# ─── Перший адміністратор ─────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=ChangeThisPassword123!

# ─── Файли ────────────────────────────────────────────────
MAX_UPLOAD_MB=250
DATA_DIR=./data
UPLOAD_DIR=./uploads

# ─── Реєстрація ───────────────────────────────────────────
# true — будь-хто може створити акаунт, false — лише адмін
ALLOW_REGISTRATION=true
